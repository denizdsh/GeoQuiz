{
  "rules": {
    ".read": "false",
    ".write": false,
      "lobbies": {
        ".write": "auth !== null",
        ".read": "auth !== null",
        "$lobby": {
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        }
      }
  }
}